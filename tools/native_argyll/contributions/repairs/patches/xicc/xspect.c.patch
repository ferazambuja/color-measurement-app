@@ -30,0 +31,2 @@
+#include <ctype.h>
+#include <errno.h>
@@ -3642,0 +3645,13 @@ char *meas_cond2str(inst_meas_cond mc) {
+/* Read a keyword value as a complete finite number. Return nz if valid */
+int xspect_read_number(char *text, double *value) {
+	char *end;
+	errno = 0;
+	*value = strtod(text, &end);
+	if (end == text || errno == ERANGE)
+		return 0;
+	while (isspace((unsigned char)*end))
+		end++;
+	return *end == '\0' && *value >= -DBL_MAX && *value <= DBL_MAX;
+}
+
