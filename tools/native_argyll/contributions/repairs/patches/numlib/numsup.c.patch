+/* C89 has no INFINITY or NAN. On a native IEEE double host, construct the */
+/* special value by bits, independent of HUGE_VAL and the rounding mode. */
+static double IEEE754_special_value(int is_nan) {
+	double one = 1.0, value;
+	ORD64 onebits, bits;
+	volatile double infinity, max;
+	if (sizeof(double) == sizeof(bits)
+	 && DBL_MANT_DIG == 53 && DBL_MAX_EXP == 1024) {
+		memcpy(&onebits, &one, sizeof(onebits));
+		if (onebits == ((ORD64)0x3ff << 52)) {
+			bits = ((ORD64)0x7ff << 52);
+			if (is_nan)
+				bits |= (ORD64)1 << 51;
+			memcpy(&value, &bits, sizeof(value));
+			return value;
+		}
+	}
+	/* Best effort for a non-IEEE native double representation. */
+	infinity = HUGE_VAL;
+	if (infinity <= DBL_MAX) {
+		max = DBL_MAX;
+		infinity = max * max;
+	}
+	if (is_nan) {
+		value = infinity - infinity;
+		if (value != value)
+			return value;
+	}
+	return infinity;	/* Without a NaN, never a finite zero */
+}
