@@ -1789 +1803 @@ static int spydX2_restore_calibration(spydX2 *p) {
-		calf_rints(&x, p->bcal, 3);
+		calf_rints(&x, p->bcal, 6);
@@ -1805 +1819,2 @@ static int spydX2_restore_calibration(spydX2 *p) {
-	a1logd(p->log, 3, "Restored spydX2_BlackCal: offsets %d %d %d\n",p->bcal[0], p->bcal[1], p->bcal[2]);
+	a1logd(p->log, 3, "Restored spydX2_BlackCal: offsets %d %d %d %d %d %d\n",
