@@ -568,0 +569,17 @@ int specbos_diff_thread(void *pp) {
+/* Return the number of bands in a 1nm wavelength range, */
+/* or 0 if the spectrum xspect can't hold it. */
+static int specbos_nbands(double wl_short, double wl_long) {
+	double bands = (wl_long - wl_short + 1.0)/1.0 + 0.5;
+
+	/* The range command sends integer endpoints. Fractional replies would */
+	/* make the band count and wavelength labels disagree with that command. */
+	if (!(wl_short > -1e6 && wl_short < 1e6
+	   && wl_long > -1e6 && wl_long < 1e6
+	   && bands >= 2.0 && bands < XSPECT_MAX_BANDS + 1.0))
+		return 0;
+	if (wl_short != (double)(int)(wl_short + 0.5)
+	 || wl_long != (double)(int)(wl_long + 0.5))
+		return 0;
+	return (int)bands;
+}
+
