+				if (used > (int)sizeof(line) - 3
+				 || (rtime = tryto - (msec_time() - stime) / 1000.0) <= 0.0)
+					break;
+				se = p->read(p, buf + used, BUFSZ - used, &bread, "\r\n", 1, rtime);
