+					return instUnknown;
+				}
+			}
+		}
@@ -2184,0 +2280,31 @@ int sym_to_inst_mode(inst_mode *mode, const char *sym) {
+/* A finite double, without relying on C99 isfinite() */
+static int inst_double_finite(double value) {
+	return value >= -DBL_MAX && value <= DBL_MAX;
+}
+
+/* Return NZ if a supplied custom filter can be evaluated by the spectral */
+/* interpolators and normalised: a finite, ordered wavelength range, enough */
+/* samples for interpolation (the composed cubic helper uses linear */
+/* interpolation below four samples), and finite, */
+/* positive normalisation and finite samples. Applied divisors must be positive. */
+int inst_valid_custom_filter(xspect *sp) {
+	int i;
+	double spcg;
+
+	if (sp == NULL || sp->spec_n < 2 || sp->spec_n > XSPECT_MAX_BANDS)
+		return 0;
+	if (!inst_double_finite(sp->spec_wl_short) || !inst_double_finite(sp->spec_wl_long)
+	 || sp->spec_wl_long <= sp->spec_wl_short)
+		return 0;
+	spcg = (sp->spec_wl_long - sp->spec_wl_short)/(sp->spec_n - 1.0);
+	if (!inst_double_finite(spcg) || spcg <= 0.0)
+		return 0;
+	if (!inst_double_finite(sp->norm) || sp->norm <= 0.0)
+		return 0;
+	for (i = 0; i < sp->spec_n; i++) {
+		if (!inst_double_finite(sp->spec[i]))
+			return 0;
+	}
+	return 1;
+}
