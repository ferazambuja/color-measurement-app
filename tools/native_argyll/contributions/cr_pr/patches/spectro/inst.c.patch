+		/* model identifies it. With its echo on (manual 4.1) the query comes */
+		/* back first. Continuation reads use the remaining probe allowance; */
+		/* write_read_ex itself has separate write/read timeouts and a flush. */
+		if ((p->dctype & icomt_btserial) == 0 && brt[i] == baud_115200) {
+			unsigned int stime = msec_time();
+			double rtime;
+			int bread, used = 0, echoed = 0, drop_lf = 0;
+
+			se = p->write_read_ex(p, "RC Model\r\n", 0, buf, BUFSZ, &bread, "\r\n", 1, tryto, 1);
+			for (;;) {
+				char *end;
+				int n, consume;
+				char line[64];
+
+				/* Serial reads return chunks, not lines: an echo may arrive
+				 * with some or all of its reply. Keep the unconsumed bytes. */
+				if (se != ICOM_OK || bread < 0 || bread >= BUFSZ - used)
+					break;
+				used += bread;
+				if ((int)strlen(buf) != used)
+					break;					/* Embedded NUL is not protocol text */
+				if (drop_lf && used > 0) {
+					if (buf[0] == '\n') {
+						used--;
+						memmove(buf, buf + 1, used + 1);
+					}
+					drop_lf = 0;
+				}
+				if ((end = strpbrk(buf, "\r\n")) != NULL) {
+					n = (int)(end - buf);
+					if (n > (int)sizeof(line) - 3)
+						break;
+					/* Normalize a complete line for the exact reply/echo tests. */
+					memcpy(line, buf, n);
+					memcpy(line + n, "\r\n", 3);
+					consume = n + 1;
+					if (*end == '\r') {
+						if (consume < used) {
+							if (buf[consume] == '\n') consume++;
+						} else
+							drop_lf = 1;
+					}
+					used -= consume;
+					memmove(buf, buf + consume, used + 1);
+					if (!echoed && cr250_model_echo(line)) {
+						echoed = 1;
+						if (used > 0) {
+							bread = 0;
+							continue;
+						}
+					} else {
+						/* One status line, with no unrelated text already buffered.
+						 * A split final LF may remain unread: init_coms must call
+						 * set_ser_port to flush before starting the new engine. */
+						if (used == 0)
